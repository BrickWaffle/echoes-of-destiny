<form class="eod-sheet" autocomplete="off">
  <header class="sheet-header">
    <img class="profile-img" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" width="96" height="96"/>
    <div class="identity">
      <input class="actor-name" name="name" type="text" value="{{actor.name}}" placeholder="Name"/>
      <div class="actor-type">{{actor.type}}</div>
      {{#if isCharacter}}
      <label>Species <input name="system.species" value="{{actor.system.species}}"/></label>
      <label>Look <input name="system.look" value="{{actor.system.look}}"/></label>
      {{/if}}
    </div>
  </header>
  {{#if isCharacter}}
  <section class="attributes">
    {{#each attributes}}
      <div class="attribute">
        <button type="button" data-roll-attribute="{{key}}" title="Roll {{label}} (Shift: Advantage, Alt: Disadvantage)">{{label}}</button>
        <input type="number" name="system.attributes.{{key}}" value="{{value}}" min="-2" max="3"/>
      </div>
    {{/each}}
  </section>
  {{/if}}
  <nav class="sheet-tabs tabs" data-group="primary">
    <a class="item" data-tab="details">Details</a>
    <a class="item" data-tab="equipment">Equipment</a>
    {{#if isCharacter}}<a class="item" data-tab="moves">Moves</a><a class="item" data-tab="echoes">Echoes</a>{{/if}}
  </nav>
  <section class="sheet-body">
    <div class="tab" data-group="primary" data-tab="details">
      <label>Description</label>
      <textarea name="system.description">{{actor.system.description}}</textarea>
      {{#if isCharacter}}
        <label>Vice <input name="system.vice" value="{{actor.system.vice}}"/></label>
        <section class="eod-reflections">
          <h3>XP Track</h3>
          <div class="eod-xp-track">
            {{#each xpBoxes}}
              <label><input type="checkbox" data-xp-box="{{index}}" {{#if checked}}checked{{/if}} aria-label="XP box {{index}}"/></label>
            {{/each}}
          </div>
          <h3>Reflections</h3>
          <p>Choose three questions as your roleplaying goals. At session's end, answer Yes to those you fulfilled and award one XP for each.</p>
          <div class="eod-reflection-list">
            {{#each reflectionQuestions}}
              <div class="eod-reflection-row">
                <label><input type="checkbox" data-reflection-select="{{index}}" {{#if selected}}checked{{/if}} {{#if ../reflectionAwarded}}disabled{{/if}}/> {{question}}</label>
                <label class="eod-reflection-yes"><input type="checkbox" data-reflection-answer="{{index}}" {{#if answered}}checked{{/if}} {{#unless selected}}disabled{{/unless}} {{#if ../reflectionAwarded}}disabled{{/if}}/> Yes</label>
              </div>
            {{/each}}
          </div>
          <p>{{reflectionCount}} of 3 selected · {{reflectionXP}} XP earned this session</p>
          {{#if reflectionAwarded}}
            <p>Session XP awarded. Begin the next session to clear answers and choose new questions.</p>
            <button type="button" data-reflection-reset>Begin Next Session</button>
          {{else}}
            <button type="button" data-reflection-award>Award Session XP</button>
          {{/if}}
        </section>
      {{/if}}
      {{#if isOrganization}}
        <label>Influence <input type="number" name="system.influence" value="{{actor.system.influence}}"/></label>
        <label>Resources <input type="number" name="system.resources" value="{{actor.system.resources}}"/></label>
        <label>Reputation <input type="number" name="system.reputation" value="{{actor.system.reputation}}"/></label>
        <label>Hidden Agenda <textarea name="system.agenda">{{actor.system.agenda}}</textarea></label>
      {{/if}}
      <h3>Conditions</h3>
      {{#each actor.system.conditions}}
        <input name="system.conditions.{{@key}}" value="{{this}}" placeholder="Condition"/>
      {{/each}}
    </div>
    <div class="tab" data-group="primary" data-tab="equipment">
      <h3>Equipment</h3>
      {{#each equipment}}<div class="item-row">{{name}}</div>{{else}}<p>No equipment yet.</p>{{/each}}
    </div>
    {{#if isCharacter}}
    <div class="tab" data-group="primary" data-tab="moves">
      <h3>Moves</h3>
      {{#each moves}}<div class="item-row">{{name}}</div>{{else}}<p>No moves yet.</p>{{/each}}
    </div>
    <div class="tab" data-group="primary" data-tab="echoes">
      <h3>Echoes of the Past</h3>
      <p>Echo tracking is planned for the next milestone.</p>
      <h3>Echoes of Destiny</h3>
      <p>Echo tracking is planned for the next milestone.</p>
    </div>
    {{/if}}
  </section>
</form>

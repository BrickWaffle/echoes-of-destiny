<form class="eod-sheet" autocomplete="off">
  <header class="sheet-header">
    <img class="profile-img" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" width="96" height="96"/>
    <div class="identity">
      <input class="actor-name" name="name" type="text" value="{{actor.name}}" placeholder="Name"/>
      <div class="actor-type">{{actor.type}}</div>
      {{#if isCharacter}}
        <div class="eod-header-fields">
          <label>Playbook
            {{#if selectedPlaybook}}<span class="eod-playbook-selected">{{selectedPlaybook}}</span>
            {{else}}<select data-select-playbook><option value="">Choose Playbook</option>{{#each playbookChoices}}<option value="{{id}}">{{name}}</option>{{/each}}</select>{{/if}}
          </label>
          <label>Look <input name="system.look" value="{{actor.system.look}}"/></label>
          <label>Vice <input name="system.vice" value="{{actor.system.vice}}"/></label>
        </div>
        <div class="eod-species-row">
          <label>Species <input name="system.species" value="{{actor.system.species}}"/></label>
          <div class="eod-inline-tags"><div class="eod-tag-list">{{#each actorTags}}<button type="button" class="eod-tag {{#if exhausted}}is-exhausted{{/if}}" data-actor-tag-toggle="{{index}}">{{name}}{{#if exhausted}} (Exhausted){{/if}}</button>{{/each}}</div><button type="button" data-edit-actor-tags>Edit Tags</button></div>
        </div>
      {{else if isNpc}}
        <div class="eod-header-fields eod-npc-fields">
          <label>Look <input name="system.look" value="{{actor.system.look}}"/></label>
          <label>Vice <input name="system.vice" value="{{actor.system.vice}}"/></label>
        </div>
        <div class="eod-species-row"><label>Species <input name="system.species" value="{{actor.system.species}}"/></label>
          <div class="eod-inline-tags"><div class="eod-tag-list">{{#each actorTags}}<button type="button" class="eod-tag {{#if exhausted}}is-exhausted{{/if}}" data-actor-tag-toggle="{{index}}">{{name}}{{#if exhausted}} (Exhausted){{/if}}</button>{{/each}}</div><button type="button" data-edit-actor-tags>Edit Tags</button></div>
        </div>
      {{else if isVehicle}}
        <div class="eod-species-row"><label>Model <input name="system.model" value="{{actor.system.model}}"/></label>
        <div class="eod-inline-tags"><div class="eod-tag-list">{{#each actorTags}}<button type="button" class="eod-tag {{#if exhausted}}is-exhausted{{/if}}" data-actor-tag-toggle="{{index}}">{{name}}{{#if exhausted}} (Exhausted){{/if}}</button>{{/each}}</div><button type="button" data-edit-actor-tags>Edit Tags</button></div></div>
      {{/if}}
    </div>
  </header>
  {{#if isCharacter}}
  <section class="attributes">
    {{#each attributes}}
      <div class="attribute">
        <button type="button" data-roll-attribute="{{key}}" title="Roll {{label}} (Shift: Advantage, Alt: Disadvantage)">{{label}}</button>
        <input type="number" name="system.attributes.{{key}}" value="{{value}}" min="-2" max="3"/>
      </div>
    {{/each}}
  </section>
  {{/if}}
  {{#if isCharacter}}<nav class="sheet-tabs tabs" data-group="primary">
    <a class="item" data-tab="details">Details</a>
    {{#if isCharacter}}<a class="item" data-tab="equipment">Equipment</a><a class="item" data-tab="moves">Moves</a><a class="item" data-tab="echoes">Echoes</a>{{/if}}
  </nav>{{/if}}
  <section class="sheet-body">
    <div class="tab {{#unless isCharacter}}active{{/unless}}" data-group="primary" data-tab="details">
      {{#if isCharacter}}
        <h3>Conditions</h3>
        <div class="eod-condition-row">{{#each actor.system.conditions}}<input name="system.conditions.{{@key}}" value="{{this}}" placeholder="Condition"/>{{/each}}</div>
        <section class="eod-reflections">
          <h3>Reflections</h3>
          <p>Select up to three questions for the session. Discuss them with the Director at session's end, then mark earned XP directly on the track below.</p>
          <div class="eod-reflection-list">{{#each reflectionQuestions}}<div class="eod-reflection-row"><label><input type="checkbox" data-reflection-select="{{index}}" {{#if selected}}checked{{/if}}/> {{question}}</label></div>{{/each}}</div>
          <p>{{reflectionCount}} of 3 selected</p>
          <h3>XP Track</h3>
          <div class="eod-xp-controls"><div class="eod-xp-track">{{#each xpBoxes}}<label><input type="checkbox" data-xp-box="{{index}}" {{#if checked}}checked{{/if}} aria-label="XP box {{index}}"/></label>{{/each}}</div><button type="button" data-open-advancement>Advancement</button></div>
        </section>
      {{else}}
        {{#if isLocation}}
          <section class="eod-actor-tags">
            <h3>{{#if isNpc}}Species & NPC Tags{{else if isVehicle}}Vehicle Tags{{else}}Tags{{/if}}</h3>
            <div class="eod-inline-tags"><div class="eod-tag-list">{{#each actorTags}}<button type="button" class="eod-tag {{#if exhausted}}is-exhausted{{/if}}" data-actor-tag-toggle="{{index}}">{{name}}{{#if exhausted}} (Exhausted){{/if}}</button>{{/each}}</div><button type="button" data-edit-actor-tags>Edit Tags</button></div>
          </section>
        {{else if isOrganization}}
          <section class="eod-actor-tags"><h3>Tags</h3><div class="eod-inline-tags"><div class="eod-tag-list">{{#each actorTags}}<button type="button" class="eod-tag {{#if exhausted}}is-exhausted{{/if}}" data-actor-tag-toggle="{{index}}">{{name}}{{#if exhausted}} (Exhausted){{/if}}</button>{{/each}}</div><button type="button" data-edit-actor-tags>Edit Tags</button></div></section>
        {{/if}}
        <label>Description</label><textarea name="system.description">{{actor.system.description}}</textarea>
        {{#if isVehicle}}
          <h3>Equipment</h3>
          {{#each equipment}}<div class="item-row"><div class="eod-gear-info"><button type="button" class="eod-item-name" data-edit-item="{{id}}">{{name}}</button><div class="eod-tag-list">{{#each tags}}<button type="button" class="eod-tag {{#if exhausted}}is-exhausted{{/if}}" data-tag-item="{{../id}}" data-tag-toggle="{{index}}">{{name}}{{#if exhausted}} (Exhausted){{/if}}</button>{{/each}}</div></div><span><button type="button" data-delete-item="{{id}}">Remove</button></span></div>{{else}}<p>No equipment yet.</p>{{/each}}
          <button type="button" data-create-item="equipment">Add Equipment</button>
        {{/if}}
        {{#if isOrganization}}{{#if showHiddenAgenda}}
          <label>Hidden Agenda <textarea name="system.agenda">{{actor.system.agenda}}</textarea></label>
        {{/if}}{{/if}}
      {{/if}}
    </div>
    {{#if isCharacter}}
      <div class="tab" data-group="primary" data-tab="equipment">
        <h3>Equipment</h3>
        {{#each equipment}}
          <div class="item-row"><div class="eod-gear-info"><button type="button" class="eod-item-name" data-edit-item="{{id}}">{{name}}</button><div class="eod-tag-list">{{#each tags}}<button type="button" class="eod-tag {{#if exhausted}}is-exhausted{{/if}}" data-tag-item="{{../id}}" data-tag-toggle="{{index}}">{{name}}{{#if exhausted}} (Exhausted){{/if}}</button>{{/each}}</div></div><span><button type="button" data-delete-item="{{id}}">Remove</button></span></div>
        {{else}}<p>No equipment yet.</p>{{/each}}
        <button type="button" data-create-item="equipment">Add Equipment</button>
      </div>
      <div class="tab" data-group="primary" data-tab="moves">
        <h3>Basic Moves</h3>
        {{#each basicMoves}}<div class="item-row"><div class="eod-move-info"><button type="button" class="eod-item-name" data-edit-item="{{id}}">{{name}}</button>{{#if description}}: {{description}}{{/if}}</div><span><button type="button" data-delete-item="{{id}}">Remove</button></span></div>{{else}}<p>No Basic Moves yet.</p>{{/each}}
        <h3>Playbook Moves</h3>
        {{#each playbookMoves}}<div class="item-row"><div class="eod-move-info"><button type="button" class="eod-item-name" data-edit-item="{{id}}">{{name}}</button>{{#if description}}: {{description}}{{/if}}</div><span><button type="button" data-delete-item="{{id}}">Remove</button></span></div>{{else}}<p>No Playbook Moves yet.</p>{{/each}}
      </div>
      <div class="tab" data-group="primary" data-tab="echoes">
        <p>Echoes begin unanswered. Narrate the scene during play to raise the current result one tier; each question may be resolved once.</p>
        <h3>Echoes of the Past</h3>
        {{#each pastEchoes}}<div class="eod-echo-row"><div class="eod-echo-copy"><p>{{question}}</p>{{#if resolved}}<p class="eod-echo-answer">{{answer}}</p>{{/if}}</div><button type="button" {{#if resolved}}data-echo-unmark="past"{{else}}data-echo-record="past"{{/if}} data-echo-index="{{index}}">{{#if resolved}}Unmark{{else}}Resolve During Play{{/if}}</button></div>{{/each}}
        <h3>Echoes of Destiny</h3>
        {{#if hasDestinyEchoes}}
          {{#each destinyEchoes}}<div class="eod-echo-row"><div class="eod-echo-copy"><p>{{question}}</p>{{#if resolved}}<p class="eod-echo-answer">{{answer}}</p>{{/if}}</div><button type="button" {{#if resolved}}data-echo-unmark="destiny"{{else}}data-echo-record="destiny"{{/if}} data-echo-index="{{index}}">{{#if resolved}}Unmark{{else}}Resolve During Play{{/if}}</button></div>{{/each}}
        {{else}}<p>Choose a playbook to see its six Echoes of Destiny.</p>{{/if}}
      </div>
    {{/if}}
  </section>
</form>

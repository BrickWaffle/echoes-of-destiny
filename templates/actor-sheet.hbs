<form class="eod-sheet" autocomplete="off">
  <header class="sheet-header">
    <img class="profile-img" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" width="96" height="96"/>
    <div class="identity">
      <input class="actor-name" name="name" type="text" value="{{actor.name}}" placeholder="Name"/>
      <div class="actor-type">{{actor.type}}</div>
      {{#if isCharacter}}
      <label>Species <input name="system.species" value="{{actor.system.species}}"/></label>
      <label>Look <input name="system.look" value="{{actor.system.look}}"/></label>
      {{/if}}
    </div>
  </header>
  {{#if isCharacter}}
  <section class="attributes">
    {{#each attributes}}
      <div class="attribute">
        <button type="button" data-roll-attribute="{{key}}" title="Roll {{label}} (Shift: Advantage, Alt: Disadvantage)">{{label}}</button>
        <input type="number" name="system.attributes.{{key}}" value="{{value}}" min="-2" max="3"/>
      </div>
    {{/each}}
  </section>
  {{/if}}
  <nav class="sheet-tabs tabs" data-group="primary">
    <a class="item" data-tab="details">Details</a>
    <a class="item" data-tab="equipment">Equipment</a>
    {{#if isCharacter}}<a class="item" data-tab="moves">Moves</a><a class="item" data-tab="echoes">Echoes</a>{{/if}}
  </nav>
  <section class="sheet-body">
    <div class="tab" data-group="primary" data-tab="details">
      <label>Description</label>
      <textarea name="system.description">{{actor.system.description}}</textarea>
      {{#if isCharacter}}
        <label>Vice <input name="system.vice" value="{{actor.system.vice}}"/></label>
        <section class="eod-reflections">
          <h3>XP Track</h3>
          <div class="eod-xp-track">
            {{#each xpBoxes}}
              <label><input type="checkbox" data-xp-box="{{index}}" {{#if checked}}checked{{/if}} aria-label="XP box {{index}}"/></label>
            {{/each}}
          </div>
          <h3>Advancement</h3>
          <p>Each advancement costs 5 XP and may be taken once. Completed choices remain marked.</p>
          <div class="eod-advancement-list">
            {{#each advancementRows}}
              <div class="eod-advancement-row">
                <span>{{#if completed}}✓ {{/if}}{{label}}</span>
                <button type="button" data-advance="{{index}}" {{#if completed}}disabled{{/if}}>{{#if completed}}Taken{{else}}Spend 5 XP{{/if}}</button>
              </div>
            {{/each}}
          </div>
          <h3>Reflections</h3>
          <p>Select up to three questions for the session. Discuss them with the Director at session's end, then mark earned XP directly on the track above.</p>
          <div class="eod-reflection-list">
            {{#each reflectionQuestions}}
              <div class="eod-reflection-row">
                <label><input type="checkbox" data-reflection-select="{{index}}" {{#if selected}}checked{{/if}}/> {{question}}</label>
              </div>
            {{/each}}
          </div>
          <p>{{reflectionCount}} of 3 selected</p>
        </section>
      {{/if}}
      {{#if isOrganization}}
        <label>Influence <input type="number" name="system.influence" value="{{actor.system.influence}}"/></label>
        <label>Resources <input type="number" name="system.resources" value="{{actor.system.resources}}"/></label>
        <label>Reputation <input type="number" name="system.reputation" value="{{actor.system.reputation}}"/></label>
        <label>Hidden Agenda <textarea name="system.agenda">{{actor.system.agenda}}</textarea></label>
      {{/if}}
      <h3>Conditions</h3>
      {{#each actor.system.conditions}}
        <input name="system.conditions.{{@key}}" value="{{this}}" placeholder="Condition"/>
      {{/each}}
    </div>
    <div class="tab" data-group="primary" data-tab="equipment">
      <h3>Equipment</h3>
      <button type="button" data-create-item="equipment">Add Equipment</button>
      {{#each equipment}}
        <div class="item-row"><div class="eod-gear-info"><strong>{{name}}</strong><div class="eod-tag-list">{{#each tags}}<button type="button" class="eod-tag {{#if exhausted}}is-exhausted{{/if}}" data-tag-item="{{../id}}" data-tag-toggle="{{index}}" title="Toggle exhausted/available">{{name}}{{#if exhausted}} (Exhausted){{/if}}</button>{{/each}}</div></div><span><button type="button" data-edit-item="{{id}}">Edit</button><button type="button" data-delete-item="{{id}}">Remove</button></span></div>
      {{else}}<p>No equipment yet.</p>{{/each}}
    </div>
    {{#if isCharacter}}
    <div class="tab" data-group="primary" data-tab="moves">
      <h3>Moves</h3>
      <button type="button" data-create-item="move">Add Move</button>
      <button type="button" data-open-compendium="echoes-of-destiny.basic-moves">Browse Basic Moves</button>
      <button type="button" data-open-compendium="echoes-of-destiny.playbook-moves">Browse Playbook Moves</button>
      {{#each moves}}
        <div class="item-row"><span>{{name}}</span><span><button type="button" data-edit-item="{{id}}">Edit</button><button type="button" data-delete-item="{{id}}">Remove</button></span></div>
      {{else}}<p>No moves yet.</p>{{/each}}
      <h3>Playbook</h3>
      {{#unless playbooks.length}}<button type="button" data-choose-playbook>Choose Playbook and Starting Moves</button>{{/unless}}
      <button type="button" data-open-compendium="echoes-of-destiny.playbooks">Browse Playbooks</button>
      {{#each playbooks}}
        <div class="item-row"><span>{{name}}</span><span><button type="button" data-edit-item="{{id}}">Edit</button><button type="button" data-delete-item="{{id}}">Remove</button></span></div>
      {{/each}}
    </div>
    <div class="tab" data-group="primary" data-tab="echoes">
      <p>Echoes begin unanswered. Narrate the scene during play to raise the current result one tier; each question may be resolved once.</p>
      <h3>Echoes of the Past</h3>
      {{#each pastEchoes}}
        <div class="eod-echo-row"><p>{{question}}</p><button type="button" {{#if resolved}}data-echo-view="past"{{else}}data-echo-record="past"{{/if}} data-echo-index="{{index}}">{{#if resolved}}Resolved — View{{else}}Resolve During Play{{/if}}</button></div>
      {{/each}}
      <h3>Echoes of Destiny</h3>
      {{#if hasDestinyEchoes}}
        {{#each destinyEchoes}}
          <div class="eod-echo-row"><p>{{question}}</p><button type="button" {{#if resolved}}data-echo-view="destiny"{{else}}data-echo-record="destiny"{{/if}} data-echo-index="{{index}}">{{#if resolved}}Resolved — View{{else}}Resolve During Play{{/if}}</button></div>
        {{/each}}
      {{else}}<p>Choose a playbook to see its six Echoes of Destiny.</p>{{/if}}
    </div>
    {{/if}}
  </section>
</form>
